		{ "type": "CheckBox", "name": "archive_PV_currentPower", "caption": "PV current Power to be archived?" },
		{ "type": "CheckBox", "name": "archive_Load_Status", "caption": "Load state to be archived?" },
		{ "type": "CheckBox", "name": "archive_LOAD_currentPower", "caption": "Load current Power to be archived?" },
		{ "type": "CheckBox", "name": "archive_Grid_Status", "caption": "Grid Status to be archived?" },
		{ "type": "CheckBox", "name": "archive_Grid_currentPower", "caption": "Grid current Power to be archived?" },
		{ "type": "CheckBox", "name": "archive_connection_0_from", "caption": "connection 0 => 'from' to be archived?" },
